{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "amirseowebsite",
  "main": "src/index.js",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "amir-seo-leads",
      "database_id": "c94ea73c-e1de-4446-b156-886b33f74b37"
    }
  ],
  "observability": { "enabled": true }
}
